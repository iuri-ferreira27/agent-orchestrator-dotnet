      { "Model": "modelo-intermediario", "InputPerMillion": 3, "OutputPerMillion": 15, "CacheReadPerMillion": 0.3, "CacheWritePerMillion": 3.75 },
      { "Model": "modelo-economico", "InputPerMillion": 1, "OutputPerMillion": 5, "CacheReadPerMillion": 0.1, "CacheWritePerMillion": 1.25 }
    ],
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiVersion": "2023-06-01"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434"
    },
    "SimulatedLatencyMs": 300
