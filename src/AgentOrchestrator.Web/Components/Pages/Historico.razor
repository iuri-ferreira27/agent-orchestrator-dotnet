@page "/historico"
@rendermode InteractiveServer
@using AgentOrchestrator.Web.Services
@inject RunHistory History

<PageTitle>Histórico</PageTitle>

<h1 class="h3">Histórico</h1>
<p class="text-muted">Últimas @RunHistory.MaxEntries execuções, guardadas só em memória (somem ao reiniciar o app).</p>

@{
    var entries = History.GetAll();
}

@if (entries.Count == 0)
{
    <div class="alert alert-secondary">
        Nenhuma execução ainda. Vá até <a href="">Orquestrador</a>, escolha um modo e clique em "Executar"
        para gerar a primeira.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle num">
            <thead>
                <tr>
                    <th>Data/hora</th>
                    <th>Modo</th>
                    <th class="text-end">Subtarefas</th>
                    <th class="text-end">Custo total</th>
                    <th class="text-end">Economia</th>
                    <th>Tarefa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in entries)
                {
                    <tr>
                        <td class="text-nowrap">@e.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@e.Mode@(e.IsSimulated ? " (simulado)" : "")</td>
                        <td class="text-end">@e.SubTaskCount</td>
                        <td class="text-end">@Format.Money(e.TotalCost)</td>
                        <td class="text-end">@(e.SavingsPercent is { } s ? Format.Percent(s) : "-")</td>
                        <td>@Excerpt(e.Task)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static string Excerpt(string task) =>
        task.Length <= 80 ? task : task[..80] + "...";
}
